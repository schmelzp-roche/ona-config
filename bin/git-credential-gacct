#!/usr/bin/env bash
# Git credential helper that picks a token per account (see accounts.conf).
# Resolution order for a request:
#   1. username in the URL (https://<user>@github.com/...)
#   2. owner/org in the path matches the "owners" column
#   3. owner equals an account's username
#   4. the active account (`gacct use <name>`), else first account for the host
# If the chosen account's token env var is empty, it outputs nothing so git
# falls through to the next helper (e.g. Ona's built-in one).
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0   # we never store/erase anything

CONF="${GACCT_CONF:-$HOME/.config/gacct/accounts.conf}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/gacct/active"
[[ -r "$CONF" ]] || exit 0

protocol="" host="" path="" username=""
while IFS='=' read -r k v; do
  [[ -z "$k" ]] && break
  case "$k" in
    protocol) protocol="$v" ;;
    host)     host="$v" ;;
    path)     path="$v" ;;
    username) username="$v" ;;
  esac
done
[[ "$protocol" == "https" ]] || exit 0

# Normalise host: *.visualstudio.com is legacy ADO
lookup_host="$host"
owner="${path%%/*}"
if [[ "$host" == *.visualstudio.com ]]; then
  lookup_host="dev.azure.com"; owner="${host%%.visualstudio.com}"
fi

# Load accounts for this host: name user tokvar owners
mapfile -t rows < <(awk -v h="$lookup_host" '!/^[[:space:]]*#/ && NF>=6 && $2==h {print $1, $3, $4, $6}' "$CONF")
((${#rows[@]})) || exit 0

pick=""
active="$(cat "$STATE" 2>/dev/null || true)"
match() { # $1 = awk-style condition on fields: name user tok owners
  for r in "${rows[@]}"; do
    read -r n u t o <<<"$r"
    if eval "$1"; then pick="$r"; return 0; fi
  done
  return 1
}
lc() { tr '[:upper:]' '[:lower:]' <<<"$1"; }
O="$(lc "$owner")"
owner_match() { # owners list may contain globs, e.g. MyOrg-*
  local p pats
  IFS=',' read -ra pats <<<"$(lc "$1")"
  for p in "${pats[@]}"; do [[ -n "$p" && "$p" != "-" && "$O" == $p ]] && return 0; done
  return 1
}

if [[ -n "$username" ]] && match '[[ "$(lc "$u")" == "$(lc "$username")" ]]'; then :
elif [[ -n "$O" ]] && match 'owner_match "$o"'; then :
elif [[ -n "$O" ]] && match '[[ "$(lc "$u")" == "$O" ]]'; then :
elif [[ -n "$active" ]] && match '[[ "$n" == "$active" ]]'; then :
else pick="${rows[0]}"
fi

read -r n u t o <<<"$pick"
token="${!t:-}"
if [[ -z "$token" ]]; then
  [[ -n "${GACCT_NOTOKEN_OK:-}" ]] && echo "username=$u"   # used by `gacct here`
  exit 0
fi

echo "username=$u"
echo "password=$token"
